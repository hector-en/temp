digraph P6_next_cycle_update_organ_lane_infractl_prompts_only {
// Hook note: lane-wide public-bundle/README/prompt_guide/DOT-path/guardrail/two-root maintenance routes through 0B + HOOK_public_bundle_lane_update_method.
// Normal lane runs do not read CLI_EXTRACTION_NOTES.md by default.
  graph [
    rankdir=TB,
    bgcolor="white",
    pad="0.35",
    nodesep="0.42",
    ranksep="0.62",
    splines=ortho,
    outputorder=edgesfirst,
    label="P6 next-cycle — request-update + organ — prompt-only execution lane\nCanonical source: infractl_merged_cheatsheet_flow_numbered_cli_extraction.dot (v7 content, consumption filename)",
    labelloc=t,
    fontsize=18,
    fontname="Arial"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#f8f8ff",
    color="#333333",
    fontname="Arial",
    fontsize=11,
    margin="0.13,0.09"
  ];

  edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.75];

  start [
    fillcolor="#ece7ff",
    color="#6b46c1",
    label=<
      <B>P6 — next-cycle for request-update + organ</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      This DOT is the self-executable prompt-only instruction for the final lane after an organ update has returned evidence.<BR ALIGN="LEFT"/>
      It is not a create lane, not a skeleton lane, and not a packaging lane.<BR ALIGN="LEFT"/>
      It begins only after P5 has completed G15 evidence-return, G16 snapshot/export, and G17 phase-decision for:<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      mode=request-update<BR ALIGN="LEFT"/>
      track=organ<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Follow the canonical v7 main pipeline. Do not invent a different end-to-end process.
    >
  ];

  address_gate [
    fillcolor="#fff7ed",
    color="#c2410c",
    label=<
      <B>Agent addressing gate</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      First decide whether you are the addressed agent.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      ChatGPT is addressed when the operator wants interpretation, variable suggestion, next-route selection, DOT reading, or prompt preparation.<BR ALIGN="LEFT"/>
      Codex is addressed only when a concrete extracted execution pack or repo-local task tells it to modify files or run bounded commands.<BR ALIGN="LEFT"/>
      WSL/operator is addressed only for shell commands that must be run in the user's environment.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      If you are not the addressed agent, stop and say which agent should act next. Do not execute another agent's step.
    >
  ];

  canonical_gate [
    fillcolor="#eef2ff",
    color="#4338ca",
    label=<
      <B>Canonical v7 route check</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Before acting, read the supplied main DOT if available:<BR ALIGN="LEFT"/>
      infractl_merged_cheatsheet_flow_numbered_cli_extraction.dot<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Confirm that this lane corresponds to the v7 post-evidence next-cycle position:<BR ALIGN="LEFT"/>
      CodexExec → EvidenceOut → CmdG16Snapshot → SnapshotFiles / ExportZip → NextPhase.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      This P6 lane consumes the G17 decision and chooses the next v7 entry route. It must not rerun P1–P5.
    >
  ];

  prior_state [
    fillcolor="#ecfeff",
    color="#0891b2",
    label=<
      <B>Required prior state from P5</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      The operator should provide or identify the completed organ-update evidence state:<BR ALIGN="LEFT"/>
      • G15 execution evidence for the organ update.<BR ALIGN="LEFT"/>
      • G16 bundle snapshot/export result, or a documented reason why export was deferred.<BR ALIGN="LEFT"/>
      • G17 phase-decision text: accepted / rejected / needs-follow-up / proceed-to-next-route.<BR ALIGN="LEFT"/>
      • The updated private bundle or private project root that is now the baseline.<BR ALIGN="LEFT"/>
      • Any warnings that remain after organ update execution.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      STOP if P5 has not produced a clear G17 decision.
    >
  ];

  organ_context [
    fillcolor="#f0fdf4",
    color="#15803d",
    label=<
      <B>Organ-update context to preserve</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      This route follows an already-created organ/R01 scaffold. It is not the initial organ scaffold creation lane.<BR ALIGN="LEFT"/>
      Keep the distinction between organ updates and skeleton batch updates explicit.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Relevant organ context files remain part of the reasoning boundary:<BR ALIGN="LEFT"/>
      • 01_B0_transition_to_real_organs_master_v2.md<BR ALIGN="LEFT"/>
      • 01_B1_transition_real_organs_codex_batch_plan_v2.md<BR ALIGN="LEFT"/>
      • day_to_day_organs_run.md<BR ALIGN="LEFT"/>
      • any organ-specific evidence snapshot generated by the completed R01/organ run<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Do not silently map organ evidence into skeleton batch numbering. Do not convert this lane into skeleton request-update.
    >
  ];

  prompt [
    fillcolor="#fff1f2",
    color="#be123c",
    label=<
      <B>Exact operator prompt to use in a new chat</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Read this DOT and the canonical main pipeline DOT:<BR ALIGN="LEFT"/>
      infractl_merged_cheatsheet_flow_numbered_cli_extraction.dot.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      We are at P6 next-cycle after completing P5 for:<BR ALIGN="LEFT"/>
      mode=request-update, track=organ.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      First suggest a variable block from the supplied evidence, filenames, bundle paths, and G17 decision. Label each value as user-provided, inferred, default-safe, or unknown. Ask me to confirm or correct the suggested variables before you route the next phase.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Do not rerun P1–P5. Do not execute Codex. Do not mutate /workspace, /mnt/ingress, or /mnt/egress unless a later confirmed lane explicitly addresses WSL/Codex to do so.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      After confirmation, choose the next v7 route and tell me the exact next prompt-only DOT file to use.
    >
  ];

  variables [
    fillcolor="#fefce8",
    color="#a16207",
    label=<
      <B>Suggested variable behavior</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Do not show an empty form first. Help the operator.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Suggest likely values for:<BR ALIGN="LEFT"/>
      • MODE=request-update [fixed by route]<BR ALIGN="LEFT"/>
      • TRACK=organ [fixed by route]<BR ALIGN="LEFT"/>
      • PRIOR_ORGAN_UPDATE_TOPIC<BR ALIGN="LEFT"/>
      • PRIOR_ORGAN_EVIDENCE_ROOT<BR ALIGN="LEFT"/>
      • G17_DECISION<BR ALIGN="LEFT"/>
      • UPDATED_PRIVATE_BUNDLE_SOURCE or PRIVATE_PROJECT_ROOT<BR ALIGN="LEFT"/>
      • NEXT_MODE<BR ALIGN="LEFT"/>
      • NEXT_TRACK<BR ALIGN="LEFT"/>
      • NEXT_BATCH_OR_ORGAN_ID<BR ALIGN="LEFT"/>
      • NEXT_TOPIC<BR ALIGN="LEFT"/>
      • PROFILE=webchat-sandbox unless explicitly changed by a later route<BR ALIGN="LEFT"/>
      • ALLOW_OVERWRITE=no<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Label every value. Ask only for values that are unknown or unsafe to infer.
    >
  ];

  idempotency [
    fillcolor="#f8fafc",
    color="#475569",
    label=<
      <B>Idempotency and no-overwrite rule</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      This P6 lane is a decision/routing lane, not a file mutation lane.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Before recommending the next route, check whether a next-route request pack, update pack, or evidence folder already exists.<BR ALIGN="LEFT"/>
      If an existing artifact appears to match the selected next route, report it and ask whether to reuse it.<BR ALIGN="LEFT"/>
      Do not tell the operator to overwrite or regenerate existing outputs unless ALLOW_OVERWRITE=yes is confirmed.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      If the G17 decision says rejected or needs-follow-up, route to the appropriate repair/update lane rather than advancing automatically.
    >
  ];

  decision_tree [
    fillcolor="#fae8ff",
    color="#a21caf",
    label=<
      <B>NextPhase decision tree</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Use the G17 decision and the actual organ state to select one next route:<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      1. If the organ update is accepted and the next work is another organ delta:<BR ALIGN="LEFT"/>
      → P1_request_update_organ_infractl_prompts_only.dot<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      2. If the organ update is accepted and the next work is a new organ scaffold/organ expansion:<BR ALIGN="LEFT"/>
      → P1_request_create_organ_infractl_prompts_only.dot<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      3. If the next work returns to skeleton implementation:<BR ALIGN="LEFT"/>
      → P1_request_create_skeleton_infractl_prompts_only.dot or P1_request_update_skeleton_infractl_prompts_only.dot<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      4. If new notes/specs/background material must be integrated first:<BR ALIGN="LEFT"/>
      → 0B_expansion_lane_infractl_prompts_only.dot<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      5. If a helper/tooling pattern or Codex friction should be extracted:<BR ALIGN="LEFT"/>
      → 0C_cli_extraction_feedback_infractl_prompts_only.dot
    >
  ];

  organ_update_next_cycle_evidence_gate [
    fillcolor="#fff7cc",
    color="#b45309",
    label=<
      <B>Organ update next-cycle evidence gate</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Do not route onward from organ update without a confirmed G17 decision from P5. G17 must be PASS or accepted documented WARN.<BR ALIGN="LEFT"/>
      Accepted organ update evidence must include <FONT FACE="Courier">UPDATE_POSTCHECK.md</FONT>, <FONT FACE="Courier">UPDATE_INTEGRATION_REQUEST.md</FONT>, and <FONT FACE="Courier">CHANGESET_MANIFEST.md</FONT>, plus smoke path/status if applicable.<BR ALIGN="LEFT"/>
      Valid next routes include another request-update + organ delta, request-create + organ for a new scaffold/expansion only when allowed, request-update/create + skeleton when the next work is a skeleton-side correction, 0B for new organ knowledge/specs, 0C for helper/CLI extraction, CIP01/CIP02/CIP03 only when evidence recommends Config-Infra processing and prerequisites are met, O-T4A/O-T4B smoke step when smoke is next, and O-T8 only after organ-complete smoke and required organ evidence exist.<BR ALIGN="LEFT"/>
      O-T9 and CIP04+ remain deferred until manifest/live-state/implementation-plan gates are selected and satisfied.<BR ALIGN="LEFT"/>
      STOP if G17 is missing or ambiguous, route identity is ambiguous, evidence is incomplete, only skeleton evidence exists, or the next step would treat skeleton evidence as organ evidence.
    >
  ];

  stop_conditions [
    fillcolor="#fee2e2",
    color="#b91c1c",
    label=<
      <B>STOP conditions</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      STOP if:<BR ALIGN="LEFT"/>
      • G17 decision is missing or ambiguous.<BR ALIGN="LEFT"/>
      • The evidence belongs to skeleton, not organ.<BR ALIGN="LEFT"/>
      • The operator wants to run Codex from this P6 routing lane.<BR ALIGN="LEFT"/>
      • The updated private bundle baseline cannot be identified.<BR ALIGN="LEFT"/>
      • The next route cannot be selected without guessing.<BR ALIGN="LEFT"/>
      • Existing outputs would be overwritten and ALLOW_OVERWRITE is not yes.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      When stopping, report the missing fact and ask only for that fact.
    >
  ];

  response [
    fillcolor="#e0f2fe",
    color="#0369a1",
    label=<
      <B>Required response format</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Respond with:<BR ALIGN="LEFT"/>
      1. Current lane confirmed: P6 next-cycle after request-update + organ.<BR ALIGN="LEFT"/>
      2. Suggested variable block with labels.<BR ALIGN="LEFT"/>
      3. Evidence/G17 status summary.<BR ALIGN="LEFT"/>
      4. Existing-output/idempotency check.<BR ALIGN="LEFT"/>
      5. Recommended next v7 route.<BR ALIGN="LEFT"/>
      6. Exact next prompt-only DOT filename.<BR ALIGN="LEFT"/>
      7. Confirmation request before any next action.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      If confirmed, provide the precise next operator prompt; otherwise wait for corrections.
    >
  ];

  pass [
    fillcolor="#dcfce7",
    color="#15803d",
    label=<
      <B>PASS / re-entry</B><BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      PASS when the next route is selected from the canonical v7 flow, the variable block is confirmed, and no overwrite or route-mismatch risk remains.<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Re-enter the pipeline by opening the exact selected prompt-only DOT in a fresh chat or continuing in the same chat with that DOT as the active instruction.
    >
  ];

  start -> address_gate;
  address_gate -> canonical_gate;
  canonical_gate -> prior_state;
  prior_state -> organ_context;
  organ_context -> prompt;
  prompt -> variables;
  variables -> organ_update_next_cycle_evidence_gate;
  organ_update_next_cycle_evidence_gate -> idempotency;
  idempotency -> decision_tree;
  decision_tree -> stop_conditions;
  stop_conditions -> response;
  response -> pass;
}
