digraph "CIP02_rich_integration_request_generation_infractl_prompts_only_v03" {
  rankdir=TB;
  compound=true;
  splines=ortho;
  nodesep=0.55;
  ranksep=0.72;
  pad="0.25,0.25";
  fontname="Helvetica";
  fontsize=10;
  labelloc="t";
  label="CIP02 rich INTEGRATION_REQUEST generation — prompt-only DOT v03 — full base_format from CIP01 master";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, margin="0.12,0.09"];
  edge [arrowsize=0.7, penwidth=1.25, fontname="Helvetica", fontsize=8, color="#555555"];
  N00_Meta [label="SELF-EXECUTABLE DOT — READ THIS FIRST\n=====================================\nThis is CIP02 v03. It is a full base_format prompt-only DOT, using CIP01 v03 as the master style.\n\nIt is a standalone instruction file for a fresh ChatGPT, Codex, or WSL/operator session that has:\n- infractl.md\n- the root main v7 DOT\n- this selected CIP02 DOT\n- a completed CIP01 CONFIG_INFRA_SUITABILITY_DECISION.md and/or .json\n- optional batch/spec/evidence files needed to write a rich INTEGRATION_REQUEST.md.\n\nCanonical read order:\n1. infractl.md\n2. root main v7 DOT\n3. this selected CIP02 DOT\n4. SPEC/ANX/hook source contract for CIP02\n5. CIP01 decision artifact\n6. only then the source files named in the variable block.\n\nDo not mix lanes. Do not run CIP03 or later stages unless CIP02 reaches PASS and the operator explicitly starts the next phase.", color="#004D40", fillcolor="#E0F2F1"];
  N01_BaseFormat [label="base_format REQUIREMENTS APPLIED HERE\n=====================================\nThis route follows the 0A/P/G prompt-only style:\n- full cold-start narrative\n- self-executable instruction file\n- required variable block before execution\n- each variable labeled user-provided, inferred, default-safe, or unknown\n- confirmation gate before execution\n- idempotency by default\n- no overwrite unless ALLOW_OVERWRITE=yes\n- addressed-agent gate: ChatGPT / Codex / WSL operator\n- exact prompt-to-type\n- input checklist\n- explicit safe/forbidden actions\n- output contract\n- required response format\n- PASS / STOP conditions\n- re-entry guidance into the CIP and v7 pipeline.\n\nCIP02 is not a short summary stage. It expands the CIP01 determiner result into a full batch-time handoff artifact.", color="#7B1FA2", fillcolor="#F3E5F5"];
  N02_PhaseIdentity [label="PHASE IDENTITY — CIP02\n======================\nMODE=config-infra\nTRACK=cip\nPHASE=CIP02\nNAME=rich_integration_request_generation\n\nPurpose:\nCIP02 converts a completed CIP01 suitability decision into a rich INTEGRATION_REQUEST.md. It records batch-time suitability truth, evidence, and likely config/lv/workflow implications for later CIP03 manifest aggregation and later S-T9/O-T9 config integration.\n\nCIP02 answers:\n- What exactly was implemented or requested?\n- What evidence supports the request?\n- What did CIP01 decide about source quality, fate, role, risk, and config-contract fit?\n- What account/profile, mount/share, Python/lv, package-stack, bootstrap, workflow, health/smoke, credential, and live-infra implications should be carried forward?\n- Which config surfaces are likely involved later, without claiming they should be edited now?\n\nDefault mutation policy:\nREAD-ONLY / DOCUMENT-GENERATION ONLY. CIP02 may create a sandbox or approved private INTEGRATION_REQUEST.md artifact. It must not mutate config files, public tooling, DOT files, live infra, bootstrap, mount, pull, push, package installs, or prior evidence.", color="#006064", fillcolor="#E0F7FA"];
  N03_CIPLegend [label="CIP LEGEND — FULL PIPELINE CONTEXT\n==================================\nCIP = Config-Infra Pipeline.\n\nCIP01 = source intake + CONFIG_INFRA_SUITABILITY_DETERMINER.\nCIP02 = rich INTEGRATION_REQUEST generation.\nCIP03 = manifest aggregation + approval.\nCIP04 = live config-state resolution.\nCIP05 = config implementation planning.\nCIP06 = idempotent application + closeout.\n\nCIP01-CIP05 are read-only / planning-only by default.\nCIP06 mutation-default is no and may mutate only after selected CIP06 DOT, manifest approval, implementation plan, explicit user confirmation, and safety gates.\n\nCIP02 is the bridge from a determiner decision into the normal Infra-Skeleton integration-request language used by skeleton/organ/workflow batches. It does not approve config work. It prepares a rich request so CIP03 can decide whether to manifest it.", color="#0D47A1", fillcolor="#E3F2FD"];
  N04_SourceContract [label="REQUIRED SOURCE CONTRACT — ANX02 + HOOK + CIP01 DECISION\n========================================================\nCIP02 must explicitly consume the matching accepted config-infra source material.\n\nRequired source contract:\n- SPEC_config_infra_integration_pipeline.md\n- SPEC_config_infra_integration_pipeline-ANX02_integration_request_schema.md\n- HOOK_config_infra_rich_integration_request.md\n- CONFIG_INFRA_SUITABILITY_DECISION.md and/or CONFIG_INFRA_SUITABILITY_DECISION.json from CIP01\n\nRecommended supporting sources when available:\n- SPEC_config_infra_integration_pipeline-ANX01_config_infra_suitability_determiner.md\n- SPEC_config_infra_integration_pipeline-ANX06_config_patch_classes.md\n- POSTCHECK.md\n- SMOKE_REPORT.md\n- CODEX_PROMPT.txt\n- RUN_INSTRUCTIONS.md\n- SPEC.md\n- COMPANION.md\n- codebase analysis report\n- operator notes\n\nIf ANX02 or the rich request hook is missing, STOP or produce a missing-source report. If the CIP01 decision is missing, STOP unless the operator explicitly requests a combined CIP01+CIP02 run and supplies enough source material to reconstruct the decision first.", color="#1B5E20", fillcolor="#E8F5E9"];
  N05_RichRequestEngine [label="RICH INTEGRATION_REQUEST GENERATOR — REQUIRED ENGINE\n====================================================\nCIP02 must run the rich request generator, not write a thin narrative.\n\nThe generator must:\n1. preserve the CIP01 primary fate, risk boundary, manifest eligibility, and config contract fit matrix\n2. translate those results into the ANX02 INTEGRATION_REQUEST schema\n3. attach evidence references and source provenance\n4. carry forward likely config surfaces with the phrase likely involved later\n5. explicitly state current environment resolved here: no\n6. explicitly state that live config truth is not resolved until CIP04\n7. distinguish batch-time suitability truth from integration-time environment truth\n8. mark blocked, experimental, already-covered, and manifest-candidate cases clearly\n9. avoid claiming config changes are valid or approved\n10. recommend the next route without silently running it.\n\nRequired policy sentence:\nThis request records batch-time suitability truth only. It may identify config surfaces likely involved later, but it does not approve or validate any config change. The later S-T9/O-T9 config-integration stage must resolve the request against live config state and may apply only manifest-approved changes.", color="#004D40", fillcolor="#E0F2F1"];
  N06_Variables [label="REQUIRED VARIABLE BLOCK\n=======================\nBefore execution, propose variables and wait for confirmation.\n\nRequired variables:\nMODE=config-infra\nTRACK=cip\nPHASE=CIP02\nREQUEST_ID=<stable request id>\nSOURCE_DECISION_MD=<path to CONFIG_INFRA_SUITABILITY_DECISION.md>\nSOURCE_DECISION_JSON=<path to CONFIG_INFRA_SUITABILITY_DECISION.json or none>\nSOURCE_EVIDENCE_PATHS=<POSTCHECK/SMOKE/SPEC/RUN/COMPANION/codebase/operator notes>\nOUTPUT_ROOT=<sandbox or approved private output root>\nOUTPUT_INTEGRATION_REQUEST=<path to INTEGRATION_REQUEST.md>\nOUTPUT_INTEGRATION_REQUEST_JSON=<path or none>\nTARGET_TRACK=skeleton|organ|config|other|unknown\nTARGET_MODE=create|update|other|unknown\nTARGET_BATCH_OR_RUN=<batch/run id or unknown>\nTARGET_SLUG_OR_TOPIC=<slug/topic>\nROLE_OWNER=<researchscientist|aiengineer|publisher|vmuser/operator|mixed|unknown|none>\nALLOW_REAL_WORKSPACE_MUTATION=no\nALLOW_CONFIG_MUTATION=no\nALLOW_PUBLIC_TOOL_EDIT=no\nALLOW_DOT_MUTATION=no\nALLOW_BOOTSTRAP=no\nALLOW_MOUNT_PULL_PUSH=no\nALLOW_LIVE_INFRA=no\nALLOW_OVERWRITE=no\n\nEvery variable must be labeled as user-provided, inferred, default-safe, or unknown.", color="#F57F17", fillcolor="#FFFDE7"];
  N07_ExactPrompt [label="EXACT PROMPT TO TYPE\n====================\nUse infractl.md and infractl.zip.\nRun CIP02 config-infra pipeline for the uploaded CIP01 suitability decision and evidence files.\n\nTask:\nGenerate a rich INTEGRATION_REQUEST.md using the accepted config-infra schema.\n\nRead infractl.md first.\nRead the root main v7 DOT next.\nThen read the selected CIP02 DOT.\nThen read ANX02 / rich request hook / CIP01 decision.\n\nDo not mutate config files.\nDo not edit public tooling.\nDo not edit DOT files.\nDo not run bootstrap, mount, pull, push, smoke, Docker, Runpod, paid APIs, package installs, or live infra.\nDo not claim live config truth.\n\nFirst suggest the routing and variable block.\nAsk me to confirm or correct it.\nDo not execute until I confirm.", color="#263238", fillcolor="#ECEFF1"];
  N08_InputChecklist [label="INPUT CHECKLIST\n===============\nRequired before PASS:\n- infractl.md read\n- root main v7 DOT read\n- selected CIP02 DOT read\n- ANX02 integration request schema read\n- HOOK_config_infra_rich_integration_request read\n- CIP01 decision artifact read\n- source evidence read or marked missing\n- target track/mode/batch/slug identified or marked unknown\n- role owner and target identity carried from CIP01 or marked unknown\n- output path checked for idempotency\n\nHelpful evidence:\n- SPEC.md\n- RUN_INSTRUCTIONS.md\n- CODEX_PROMPT.txt\n- POSTCHECK.md\n- SMOKE_REPORT.md\n- codebase analysis\n- COMPANION.md\n- changed files list\n- operator notes\n\nMissing sources must be listed explicitly. Do not invent evidence.", color="#01579B", fillcolor="#E1F5FE"];
  N09_TopMatterSchema [label="INTEGRATION_REQUEST TOP MATTER\n==============================\nCIP02 must write required top matter.\n\nRequired fields:\n# INTEGRATION_REQUEST — <track> <batch/run> <slug/topic>\n\nStatus: draft | checked | ready-for-manifest | blocked\nTrack: skeleton | organ | config | other\nMode: create | update | other\nBatch/run:\nSlug/topic:\nRequest ID:\nSource evidence date/context:\nPrepared by:\nCIP01 decision source:\nPrimary fate:\nManifest eligibility:\nResolution required at integration time: yes/no\n\nStatus rules:\n- draft when evidence is incomplete but usable\n- checked when evidence is sufficient but not yet manifest-ready\n- ready-for-manifest when CIP01 eligibility supports CIP03 review\n- blocked when fate/risk/source quality blocks promotion.", color="#33691E", fillcolor="#F1F8E9"];
  N10_EvidenceSchema [label="EVIDENCE SOURCES SECTION\n========================\nCIP02 must include an evidence sources section with provenance.\n\nRequired evidence fields:\nSPEC:\nRUN_INSTRUCTIONS:\nCODEX_PROMPT:\nPOSTCHECK:\nSMOKE_REPORT:\ncodebase analysis:\nCOMPANION:\nchanged files:\noperator notes:\nCIP01 decision:\nmissing evidence:\n\nEvidence quality must match CIP01:\n- idea-only\n- spec-only\n- implemented-code\n- implemented-code-plus-postcheck\n- implemented-code-plus-smoke\n- repeated-across-batches\n\nDo not upgrade evidence strength in CIP02 unless the operator provides new evidence and the change is explicitly noted.", color="#0D47A1", fillcolor="#E3F2FD"];
  N11_SuitabilitySection [label="CONFIG-SYSTEM SUITABILITY ASSESSMENT SECTION\n============================================\nCIP02 must include a rich section named exactly:\n## Config-system suitability assessment\n\nRequired fields:\nRequest source:\nEvidence strength:\nRecommended fate:\nPrimary fate reason:\nSecondary fates:\nManifest eligibility:\nRisk boundary:\nRole owner:\nTarget identity expected:\nTarget work identity:\nConfig-side operator identity:\nWorkspace roots produced:\nCommands produced:\nCommands safe to expose:\nOutputs/artifacts produced:\nSmoke/health checks produced:\nAccount/profile implication:\nMount/share implication:\nPython/lv implication:\nPackage-stack implication:\nBootstrap-step implication:\nWorkflow/alias/launcher implication:\nHealth-check/smoke implication:\nCredential/secret implication:\nLive infra implication:\nConfig surfaces likely involved later:\nCurrent environment resolved here: no\nResolution required at integration time: yes/no\nSafety boundaries:\nEvidence references:\n\nThis section must inherit the CIP01 config contract fit matrix rather than replacing it with vague prose.", color="#4A148C", fillcolor="#F3E5F5"];
  N12_ImplicationMatrices [label="REQUIRED IMPLICATION MATRICES\n=============================\nCIP02 must expand each config contract axis into the request.\n\nInclude these sections even when conclusion is none:\n1. Workspace roots produced or expected\n2. Config-managed account/profile implication\n3. Mount/share implication\n4. Python/lv implication\n5. Package-stack implication\n6. Bootstrap-step implication\n7. Command/workflow exposure\n8. Config surfaces likely involved later\n9. Safety boundaries\n10. Current environment not resolved here\n\nFor each implication include:\n- conclusion\n- evidence\n- likely later surfaces\n- resolution required at integration time yes/no\n- what must not be assumed now\n\nUse likely involved later, not edit now.", color="#1A237E", fillcolor="#E8EAF6"];
  N13_ConfigSurfaces [label="CONFIG SURFACES LIKELY INVOLVED LATER\n======================================\nCIP02 must include the explicit surface checklist.\n\n- targets/<user>.env: yes/no/unknown\n- install/python-env-profiles.tsv: yes/no/unknown\n- install/packages.env: yes/no/unknown\n- bootstrap/steps.tsv: yes/no/unknown\n- bootstrap/profiles/<profile>.plan: yes/no/unknown\n- accounts/profiles.tsv: yes/no/unknown\n- accounts/smb-profiles.tsv: yes/no/unknown\n- accounts/mount-profiles.tsv: yes/no/unknown\n- config.sh allowlist: yes/no/unknown\n- installers.sh: yes/no/unknown\n- mounts/mounts.env: yes/no/unknown\n- create-cifs-credentials-files.sh: yes/no/unknown\n- lv / conda / venv state: yes/no/unknown\n- target state markers: yes/no/unknown\n- none: yes/no\n\nDo not assert existence or validity of any live surface unless a prior CIP04 snapshot proves it.", color="#00695C", fillcolor="#E0F2F1"];
  N14_SafetyBoundaries [label="SAFETY BOUNDARIES SECTION\n=========================\nCIP02 must write explicit safety boundaries.\n\nRequired statements:\n- This request records batch-time suitability truth only.\n- This request does not approve config mutation.\n- This request does not validate current live config state.\n- CIP04 is the first phase that resolves live config truth.\n- S-T9/O-T9 or CIP06 may apply only manifest-approved changes after explicit confirmation.\n- No secrets, credential contents, passwords, private vault text, or raw sensitive dataset content are included.\n- Live infra, bootstrap, mount, pull, push, package installs, Docker, Runpod, paid APIs, and destructive account lifecycle actions are not authorized by this request.\n\nIf any requested capability touches credentials/live/destructive actions, mark it as blocked or gated for human design and manifest approval.", color="#B71C1C", fillcolor="#FFEBEE"];
  N15_OutputContract [label="OUTPUT ARTIFACT CONTRACT\n========================\nPrimary output:\n- INTEGRATION_REQUEST.md\n\nOptional machine-readable output:\n- INTEGRATION_REQUEST.json\n\nThe Markdown request must contain:\n- required top matter\n- summary\n- evidence sources\n- config-system suitability assessment\n- workspace roots\n- account/profile implication\n- mount/share implication\n- Python/lv implication\n- package-stack implication\n- bootstrap-step implication\n- command/workflow exposure\n- config surfaces likely involved later\n- safety boundaries\n- current environment not resolved here\n- recommended next route\n\nThe JSON output, when created, must preserve top matter, evidence, suitability, implications, surfaces, safety, fate, and manifest eligibility.", color="#2E7D32", fillcolor="#E8F5E9"];
  N16_MDTemplate [label="INTEGRATION_REQUEST.md TEMPLATE\n===============================\n# INTEGRATION_REQUEST — <track> <batch/run> <slug/topic>\n\nStatus:\nTrack:\nMode:\nBatch/run:\nSlug/topic:\nRequest ID:\nSource evidence date/context:\nPrepared by:\nCIP01 decision source:\nPrimary fate:\nManifest eligibility:\nResolution required at integration time:\n\n## Summary\n<what was implemented/requested and why it may need config/lv/workflow integration later>\n\n## Evidence sources\nSPEC:\nRUN_INSTRUCTIONS:\nCODEX_PROMPT:\nPOSTCHECK:\nSMOKE_REPORT:\ncodebase analysis:\nCOMPANION:\nchanged files:\noperator notes:\nCIP01 decision:\nmissing evidence:\n\n## Config-system suitability assessment\n<full required rich section>\n\n## Workspace roots produced or expected\nRepos:\nData:\nRuns:\nArtifacts:\nModels/checkpoints/logs:\n\n## Config-managed account/profile implication\nExpected account profile:\nExpected target env file:\nExpected role group:\nExpected home ownership:\nExisting profile likely sufficient:\nNew profile candidate:\nResolution required at integration time:\nNotes:\n\n## Mount/share implication\nIngress:\nEgress:\nResearch share:\nPublish share:\nDistrohome:\nScripting:\nCredential sensitivity:\nMount profile likely sufficient:\nNew mount/share policy candidate:\nResolution required at integration time:\nNotes:\n\n## Python/lv implication\nSuggested target env:\nEnv manager:\nPrototype env requested:\nStable role env requested:\nPackages observed from code:\nPackage import names:\nPackage install names:\nPackages already known in config/package policy:\nExisting Python env profile likely sufficient:\nNew Python env profile candidate:\nResolution required at integration time:\nNotes:\n\n## Package-stack implication\nExisting package stack likely sufficient:\nPackage stack extension candidate:\nOne-off/prototype only:\nPackage variables likely involved later:\nEvidence from smoke/tests:\nShould not be promoted because:\n\n## Bootstrap-step implication\nExisting managed step candidate:\nNew managed step candidate:\nCheck-only step candidate:\nInstall step candidate:\nStep name suggestion, if any:\nFunction name suggestion, if any:\nShould not become bootstrap step because:\nResolution required at integration time:\n\n## Command/workflow exposure\nCommand to expose:\nOwner role:\nExpected working directory:\nRequired env:\nInputs:\nOutputs:\nSmoke/health check:\nLauncher/alias/workflow candidate:\nReason this should or should not be exposed:\n\n## Config surfaces likely involved later\n<surface checklist>\n\n## Safety boundaries\n<required safety text>\n\n## Current environment not resolved here\nCIP02 did not inspect live config state. CIP04 is the first phase that resolves live config truth.\n\n## Recommended next route\n<usually CIP03 if manifest candidate; otherwise stop/defer/update evidence>", color="#00695C", fillcolor="#E0F2F1"];
  N17_JSONTemplate [label="INTEGRATION_REQUEST.json TEMPLATE\n=================================\n{\n  \"request_id\": \"\",\n  \"status\": \"draft|checked|ready-for-manifest|blocked\",\n  \"track\": \"skeleton|organ|config|other\",\n  \"mode\": \"create|update|other\",\n  \"batch_or_run\": \"\",\n  \"slug_or_topic\": \"\",\n  \"source_evidence_date_context\": \"\",\n  \"prepared_by\": \"\",\n  \"cip01_decision_source\": \"\",\n  \"primary_fate\": \"\",\n  \"manifest_eligibility\": \"\",\n  \"resolution_required_at_integration_time\": true,\n  \"summary\": \"\",\n  \"evidence_sources\": {},\n  \"config_system_suitability_assessment\": {},\n  \"workspace_roots\": {},\n  \"account_profile_implication\": {},\n  \"mount_share_implication\": {},\n  \"python_lv_implication\": {},\n  \"package_stack_implication\": {},\n  \"bootstrap_step_implication\": {},\n  \"command_workflow_exposure\": {},\n  \"config_surfaces_likely_involved_later\": {},\n  \"safety_boundaries\": [],\n  \"current_environment_resolved_here\": false,\n  \"recommended_next_route\": \"\"\n}", color="#283593", fillcolor="#E8EAF6"];
  N18_Idempotency [label="IDEMPOTENCY CHECKS BEFORE OUTPUT\n================================\nBefore writing outputs:\n- check whether INTEGRATION_REQUEST.md already exists at output path\n- if it exists and ALLOW_OVERWRITE=no, create a versioned output or ask for confirmation\n- preserve prior request if source evidence has not changed\n- if generating an updated request, record what changed from the prior version\n- do not silently replace a ready-for-manifest request with a weaker draft\n- do not duplicate request IDs silently\n- do not upgrade status unless evidence supports it.\n\nSame CIP01 decision plus same evidence should produce the same INTEGRATION_REQUEST content.", color="#F9A825", fillcolor="#FFFDE7"];
  N19_SafeForbidden [label="SAFE COMMANDS / FORBIDDEN ACTIONS\n=================================\nAllowed in CIP02:\n- read provided markdown/spec/evidence/codebase/decision files\n- unpack uploaded source zips into sandbox\n- create INTEGRATION_REQUEST.md/json in sandbox or approved private output root\n- create missing-source report\n- produce operator handoff text for CIP03\n\nForbidden in CIP02:\n- edit config files\n- edit public tooling\n- edit main DOT or CIP DOT files\n- mutate private evidence or companion outputs unless explicitly in approved output scope\n- run bootstrap, mount, pull, push\n- run Docker, Runpod, paid APIs, package installs, broad smoke, or live infra\n- read or print credential contents\n- assert current live config state unless provided by explicit prior CIP04 snapshot.", color="#BF360C", fillcolor="#FBE9E7"];
  N20_ResponseFormat [label="REQUIRED RESPONSE FORMAT\n========================\nCurrent phase: CIP02 rich INTEGRATION_REQUEST generation\nSelected DOT:\nAddressed role:\nVariable block proposed/confirmed:\nSource contract status:\nCIP01 decision source:\nEvidence files read:\nMissing sources:\nPrimary fate carried forward:\nManifest eligibility carried forward:\nRisk boundary carried forward:\nConfig surfaces likely involved later:\nOutput request path:\nOutput JSON path if any:\nSafety status:\nDecision: PASS / STOP\nRecommended next route:", color="#37474F", fillcolor="#ECEFF1"];
  N21_PassStop [label="PASS / STOP CONDITIONS\n======================\nPASS only if:\n- variables confirmed\n- ANX02 and rich request hook applied or missing-source fallback documented\n- CIP01 decision artifact read\n- evidence files read or missing sources listed\n- top matter complete\n- config-system suitability assessment complete\n- all implication sections present even when conclusion is none\n- config surfaces checklist present\n- current environment resolved here: no\n- safety boundaries present\n- output artifact contract satisfied or proposed\n- no forbidden mutation occurred.\n\nSTOP if:\n- user has not confirmed\n- CIP01 decision is missing and no combined-run permission exists\n- ANX02 or rich request hook is unavailable with no acceptable fallback\n- evidence is too contradictory to write a trustworthy request\n- output would overwrite with ALLOW_OVERWRITE=no\n- the user requests config mutation, live-state resolution, public tooling edit, DOT edit, bootstrap, mount, pull, push, package install, smoke, or live infra.\n\nAfter PASS:\nDo not silently run CIP03. Recommend CIP03 only if the request is ready for manifest aggregation/approval.", color="#B71C1C", fillcolor="#FFEBEE"];
  N22_Reentry [label="RE-ENTRY INTO CIP AND V7 PIPELINE\n=================================\nIf the output status is blocked, route back to the operator, CIP01, or evidence collection.\n\nIf the output status is draft, gather missing evidence before CIP03.\n\nIf the output status is checked or ready-for-manifest, the normal next route is CIP03 manifest aggregation and approval.\n\nCIP02 can also feed normal request-create/request-update skeleton and organ lanes by providing the rich integration-request section those lanes must carry forward.\n\nCIP02 does not replace implementation lanes. It creates the handoff artifact that later manifest/config integration uses.", color="#333333", fillcolor="#F5F5F5"];
  N00_Meta -> N01_BaseFormat;
  N01_BaseFormat -> N02_PhaseIdentity;
  N02_PhaseIdentity -> N03_CIPLegend;
  N03_CIPLegend -> N04_SourceContract;
  N04_SourceContract -> N05_RichRequestEngine;
  N05_RichRequestEngine -> N06_Variables;
  N06_Variables -> N07_ExactPrompt;
  N07_ExactPrompt -> N08_InputChecklist;
  N08_InputChecklist -> N09_TopMatterSchema;
  N09_TopMatterSchema -> N10_EvidenceSchema;
  N10_EvidenceSchema -> N11_SuitabilitySection;
  N11_SuitabilitySection -> N12_ImplicationMatrices;
  N12_ImplicationMatrices -> N13_ConfigSurfaces;
  N13_ConfigSurfaces -> N14_SafetyBoundaries;
  N14_SafetyBoundaries -> N15_OutputContract;
  N15_OutputContract -> N16_MDTemplate;
  N16_MDTemplate -> N17_JSONTemplate;
  N17_JSONTemplate -> N18_Idempotency;
  N18_Idempotency -> N19_SafeForbidden;
  N19_SafeForbidden -> N20_ResponseFormat;
  N20_ResponseFormat -> N21_PassStop;
  N21_PassStop -> N22_Reentry;
}
