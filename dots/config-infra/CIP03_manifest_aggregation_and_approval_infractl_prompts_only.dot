digraph "CIP03_manifest_aggregation_and_approval_infractl_prompts_only_v03" {
  rankdir=TB;
  compound=true;
  splines=ortho;
  nodesep=0.55;
  ranksep=0.72;
  pad="0.25,0.25";
  fontname="Helvetica";
  fontsize=10;
  labelloc="t";
  label="CIP03 manifest aggregation + approval — prompt-only DOT v03 — full base_format from CIP01 master";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, margin="0.12,0.09"];
  edge [arrowsize=0.7, penwidth=1.25, fontname="Helvetica", fontsize=8, color="#555555"];
  N00_Meta [label="SELF-EXECUTABLE DOT — READ THIS FIRST\n=====================================\nThis is CIP03 v03. It is a full base_format prompt-only DOT, using CIP01 v03 as the master style.\n\nIt is a standalone route for a fresh ChatGPT, Codex, or WSL/operator session.\nCanonical read order:\n1. infractl.md\n2. root main v7 DOT\n3. this selected CIP03 DOT\n4. CIP03 source contract: ANX03 + manifest hook\n5. source INTEGRATION_REQUEST.md/json files\n6. supporting evidence named in the variable block.\n\nDo not mix lanes. Do not run CIP04 unless CIP03 reaches PASS and the operator explicitly starts CIP04.", color="#004D40", fillcolor="#E0F2F1"];
  N01_BaseFormat [label="base_format REQUIREMENTS APPLIED HERE\n=====================================\nThis route follows the 0A/P/G prompt-only style:\n- full cold-start narrative\n- self-executable instruction file\n- required variable block before execution\n- each variable labeled user-provided, inferred, default-safe, or unknown\n- confirmation gate before execution\n- idempotency by default\n- no overwrite unless ALLOW_OVERWRITE=yes\n- addressed-agent gate\n- exact prompt-to-type\n- input checklist\n- explicit safe/forbidden actions\n- output contract\n- required response format\n- PASS / STOP conditions\n- re-entry guidance.\n\nCIP03 is not a summary stage. It is the approval gate between rich requests and live config-state resolution.", color="#7B1FA2", fillcolor="#F3E5F5"];
  N02_PhaseIdentity [label="PHASE IDENTITY — CIP03\n======================\nMODE=config-infra\nTRACK=cip\nPHASE=CIP03\nNAME=manifest_aggregation_and_approval\n\nPurpose:\nCIP03 aggregates rich INTEGRATION_REQUEST artifacts into an INTEGRATION_MANIFEST approval gate. It decides which requests are approved, deferred, blocked, duplicate, already covered, or rejected.\n\nDefault mutation policy:\nREAD-ONLY / APPROVAL-DOCUMENT GENERATION ONLY. CIP03 may create INTEGRATION_MANIFEST.md/json in sandbox or approved private output scope. It must not resolve live config state, mutate config, edit public tooling, edit DOTs, run bootstrap/mount/pull/push, install packages, or touch live infra.", color="#006064", fillcolor="#E0F7FA"];
  N03_CIPLegend [label="CIP LEGEND — FULL PIPELINE CONTEXT\n==================================\nCIP01 = source intake + CONFIG_INFRA_SUITABILITY_DETERMINER.\nCIP02 = rich INTEGRATION_REQUEST generation.\nCIP03 = manifest aggregation + approval.\nCIP04 = live config-state resolution.\nCIP05 = config implementation planning.\nCIP06 = idempotent application + closeout.\n\nTruth split:\n- CIP01/CIP02 capture batch-time suitability/request truth.\n- CIP03 makes approval and deferral decisions.\n- CIP04 is the first phase that resolves integration-time live config truth.\n- CIP05 plans implementation against manifest approval and live snapshot.\n- CIP06 may apply only after manifest approval, plan, selected DOT, explicit confirmation, and safety gates.", color="#0D47A1", fillcolor="#E3F2FD"];
  N04_SourceContract [label="REQUIRED SOURCE CONTRACT — ANX03 + MANIFEST HOOK + REQUESTS\n==========================================================\nCIP03 must consume:\n- SPEC_config_infra_integration_pipeline.md\n- SPEC_config_infra_integration_pipeline-ANX03_integration_manifest_schema.md\n- HOOK_config_infra_manifest_gate.md\n- one or more rich INTEGRATION_REQUEST.md/json artifacts.\n\nRecommended support:\n- ANX01 suitability determiner\n- ANX02 request schema\n- ANX06 patch classes\n- CIP01 decisions for each request\n- POSTCHECK, SMOKE_REPORT, COMPANION, codebase report, operator notes.\n\nIf ANX03 or hook is missing, STOP or produce a missing-source report. If no source requests are provided, STOP unless the operator explicitly requests an empty template only.", color="#1B5E20", fillcolor="#E8F5E9"];
  N05_ManifestEngine [label="INTEGRATION_MANIFEST GATE — REQUIRED DECISION ENGINE\n===================================================\nCIP03 must run the manifest gate, not write a thin list.\n\nThe gate must:\n1. inventory every source request\n2. preserve request ID, fate, evidence strength, role, target identity, risk, and manifest eligibility\n3. deduplicate without hiding provenance\n4. classify each item using manifest status vocabulary\n5. decide allowed and forbidden config surfaces per item\n6. require live-state checks for CIP04\n7. select a patch class or explicitly defer/block\n8. define validation and post-config evidence expectations without executing them\n9. identify approval owner/operator when known\n10. mark manifest status: draft, partial, approved, or blocked.\n\nPolicy: INTEGRATION_MANIFEST may approve later resolution/planning only. It does not modify config files.", color="#4A148C", fillcolor="#F3E5F5"];
  N06_Variables [label="REQUIRED VARIABLE BLOCK\n=======================\nPropose and wait for confirmation:\nMODE=config-infra\nTRACK=cip\nPHASE=CIP03\nMANIFEST_ID=<stable manifest id>\nMANIFEST_TOPIC=<date/topic/scope>\nSOURCE_REQUEST_PATHS=<INTEGRATION_REQUEST.md/json files>\nSOURCE_DECISION_PATHS=<optional CIP01 decision files>\nSOURCE_EVIDENCE_PATHS=<POSTCHECK/SMOKE/COMPANION/codebase/operator notes>\nOUTPUT_ROOT=<sandbox or approved private output root>\nOUTPUT_MANIFEST_MD=INTEGRATION_MANIFEST.md\nOUTPUT_MANIFEST_JSON=INTEGRATION_MANIFEST.json\nCONFIG_INTEGRATION_TARGET_PHASE=S-T9 | O-T9 | dedicated-config-lane | unknown\nAPPROVER_OPERATOR=<operator or unknown>\nSCOPE=skeleton | organ | config | mixed | unknown\nALLOW_REAL_WORKSPACE_MUTATION=no\nALLOW_CONFIG_MUTATION=no\nALLOW_PUBLIC_TOOL_EDIT=no\nALLOW_DOT_MUTATION=no\nALLOW_LIVE_CONFIG_RESOLUTION=no\nALLOW_BOOTSTRAP=no\nALLOW_MOUNT_PULL_PUSH=no\nALLOW_LIVE_INFRA=no\nALLOW_OVERWRITE=no\n\nEvery variable must be labeled user-provided, inferred, default-safe, or unknown.", color="#F57F17", fillcolor="#FFFDE7"];
  N07_ExactPrompt [label="EXACT PROMPT TO TYPE\n====================\nUse infractl.md and infractl.zip.\nRun CIP03 config-infra pipeline for the uploaded INTEGRATION_REQUEST files.\n\nTask:\nAggregate and classify requests into INTEGRATION_MANIFEST.md using the accepted config-infra manifest schema and manifest gate hook.\n\nRead infractl.md first.\nRead the root main v7 DOT next.\nThen read the selected CIP03 DOT.\nThen read ANX03 / manifest hook / source INTEGRATION_REQUEST files.\n\nDo not mutate config files, public tooling, DOT files, or evidence. Do not resolve live config state. Do not run bootstrap, mount, pull, push, smoke, Docker, Runpod, paid APIs, package installs, or live infra.\n\nSuggest routing and variables first. Ask for confirmation. Do not execute until confirmed.", color="#263238", fillcolor="#ECEFF1"];
  N08_InputChecklist [label="INPUT CHECKLIST\n===============\nRequired before PASS:\n- infractl.md read\n- root main v7 DOT read\n- selected CIP03 DOT read\n- ANX03 read\n- HOOK_config_infra_manifest_gate read\n- at least one source INTEGRATION_REQUEST read\n- source requests inventoried\n- duplicates checked\n- target phase chosen or unknown\n- approver/operator identified or unknown\n- output path checked for idempotency.\n\nHelpful evidence:\nCIP01 decision, POSTCHECK, SMOKE_REPORT, COMPANION, codebase analysis, changed files, operator notes, S-T8/O-T8 context.\n\nMissing sources must be listed. Do not invent evidence or approvals.", color="#01579B", fillcolor="#E1F5FE"];
  N09_RequestInventory [label="SOURCE REQUEST INVENTORY\n========================\nBuild an inventory table with:\n- request ID\n- source path\n- source status\n- role owner\n- target identity\n- evidence strength\n- primary fate\n- manifest eligibility\n- risk boundary\n- requested config surfaces likely involved later\n- duplicate group\n- proposed manifest status.\n\nEvery request must be classified. Do not drop rejected, blocked, duplicate, experiment-only, or already-covered requests; include them with reason.", color="#00695C", fillcolor="#E0F2F1"];
  N10_StatusVocabulary [label="MANIFEST STATUS VOCABULARY — REQUIRED\n=====================================\napproved_now\napproved_as_existing_step_enablement\napproved_as_package_policy_update\napproved_as_target_env_policy_update\napproved_as_python_env_profile_update\napproved_as_new_managed_check_step\napproved_as_new_managed_install_step\napproved_as_role_profile_update\napproved_as_mount_share_policy_update\napproved_as_workflow_alias_launcher\napproved_as_health_smoke_status_hook\ndeferred_experiment\ndeferred_until_repeated\nalready_covered\nduplicate\nblocked_missing_evidence\nblocked_needs_human_design\nblocked_live_sensitive\nblocked_secret_sensitive\nrejected_not_config\n\nApproved status permits later CIP04/CIP05/CIP06 consideration; it is not execution.", color="#F57F17", fillcolor="#FFF8E1"];
  N11_ApprovalRubric [label="APPROVAL / DEFERRAL RUBRIC\n==========================\nApprove only if evidence is sufficient, role is clear or explicitly mixed, safety boundaries are clear, config surfaces are bounded, live checks are known, and the request belongs in stable config contract.\n\nDefer when evidence is one-off/prototype, recurrence is not proven, or request may become config later but should not enter the contract yet.\n\nBlock when evidence is missing, human design is required, secret/credential/live/destructive/account lifecycle risk is present without explicit design, or requested surfaces are too broad.\n\nReject when request is not config-infra relevant.", color="#BF360C", fillcolor="#FFEBEE"];
  N12_DedupeGrouping [label="DEDUPLICATION AND GROUPING RULES\n================================\nDuplicate if same ID, same capability/role/surfaces, same package/step/workflow request, or older weaker version.\n\nOverlapping but not duplicate if same capability with different role, same package with different fate, same role with different patch class, or same check with different safety boundary.\n\nFor duplicates: choose canonical request, mark others duplicate, preserve provenance. For grouped items: define group, list all source requests, state why grouping is safe or not.", color="#4E342E", fillcolor="#EFEBE9"];
  N13_ItemSchema [label="MANIFEST ITEM SCHEMA\n====================\nEach item requires:\nItem ID\nShort name\nSource request(s)\nSource evidence\nRole owner\nTarget identity\nApproved fate\nManifest status\nRisk class\nAllowed config surfaces\nForbidden config surfaces\nRequired live-state checks\nSelected patch class\nRequired implementation recipe\nRequired validation commands\nPost-config smoke/health check\nEvidence outputs required\nRollback/stop rule\nApproval owner\nApproval notes\n\nFor deferred/blocked/rejected items, fill unavailable implementation fields as not_applicable and explain why.", color="#283593", fillcolor="#E8EAF6"];
  N14_SurfaceGate [label="ALLOWED / FORBIDDEN CONFIG SURFACE GATE\n=======================================\nPossible allowed surfaces:\naccounts/profiles.tsv; accounts/smb-profiles.tsv; accounts/mount-profiles.tsv; targets/<user>.env; install/python-env-profiles.tsv; install/packages.env; bootstrap/steps.tsv; bootstrap/profiles/*.plan; config.sh allowlist; installers.sh trusted functions; mounts/mounts.env; role workflow docs; aliases/launchers; health/smoke/status hooks.\n\nExplicitly forbid when risky:\ncredential contents; secret files; live provider credentials; destructive account lifecycle; broad bootstrap/install/mount/pull/push; public tooling edits unless approved; DOT edits unless in DOT architecture lane.\n\nCIP03 may allow surfaces for later planning; it must not edit them.", color="#6A1B9A", fillcolor="#F3E5F5"];
  N15_LiveChecksPatchClass [label="LIVE-STATE CHECKS AND PATCH CLASS SELECTION\n==========================================\nCIP03 defines what CIP04 must inspect and what CIP05 may plan.\n\nLive-state checks may include:\nconfig-show; bootstrap status; bootstrap steps; config profiles; lv; lv conda <env>; grep/check steps.tsv; grep/check installers.sh function; grep/check config.sh allowlist; inspect target env and PYTHON_ENV fields; inspect profile plans; inspect state markers.\n\nPatch class candidates:\nalready-covered; no-op; target-env-policy-update; python-env-profile-update; package-stack-extension; existing-bootstrap-step-enable; role-bootstrap-plan-update; new-managed-check-step; new-managed-install-step; workflow-alias-launcher-update; health-smoke-status-hook-update; mount-share-policy-update; credential-workflow-update; new-role-or-account-profile; blocked-high-risk; needs-human-resolution.\n\nCIP03 selects candidates; CIP05 validates against live state.", color="#1565C0", fillcolor="#E3F2FD"];
  N16_OutputContract [label="OUTPUT ARTIFACT CONTRACT\n========================\nPrimary output: INTEGRATION_MANIFEST.md\nOptional output: INTEGRATION_MANIFEST.json\n\nMarkdown must contain:\n- required header\n- manifest policy\n- source request inventory\n- duplicate/grouping decisions\n- manifest summary\n- one item section per request/group\n- status for every source request\n- allowed/forbidden config surfaces\n- required live-state checks\n- selected patch class or blocked/deferred reason\n- validation/evidence expectations\n- stop/rollback rules\n- no implicit writes policy.\n\nJSON must preserve inventory, items, statuses, surfaces, live checks, patch classes, evidence requirements, and safety gates.", color="#2E7D32", fillcolor="#E8F5E9"];
  N17_MDTemplate [label="INTEGRATION_MANIFEST.md TEMPLATE\n================================\n# INTEGRATION_MANIFEST — <scope> <date/topic>\n\nStatus: draft | approved | blocked | partial\nScope:\nCreated from:\nApprover/operator:\nConfig integration target phase: S-T9 | O-T9 | dedicated config lane\nPrepared by:\nCIP03 source contract:\n\n## Manifest policy\nThis manifest may approve requests for later live-state resolution and implementation planning. It does not modify config files.\n\n## Source requests\n| ID | Source path | Role | Target identity | Evidence strength | Recommended fate | Risk | Manifest status |\n\n## Duplicate and grouping decisions\n\n## Manifest summary\nApproved now:\nDeferred:\nAlready covered:\nDuplicates:\nBlocked:\nRejected:\n\n## Item <ID> — <short name>\nSource request:\nSource evidence:\nRole owner:\nTarget identity:\nApproved fate:\nManifest status:\nRisk class:\nAllowed config surfaces:\nForbidden config surfaces:\nRequired live-state checks:\nSelected patch class:\nRequired implementation recipe:\nRequired validation commands:\nPost-config smoke/health check:\nEvidence outputs required:\nRollback/stop rule:\nApproval owner:\nApproval notes:\n\n## No implicit writes\nNo config/public/DOT/live/bootstrap/mount/pull/push/package/credential action was performed.\n\n## Recommended next route", color="#00695C", fillcolor="#E0F2F1"];
  N18_JSONTemplate [label="INTEGRATION_MANIFEST.json TEMPLATE\n==================================\n{\n  \"manifest_id\": \"\",\n  \"status\": \"draft|approved|blocked|partial\",\n  \"scope\": \"skeleton|organ|config|mixed|unknown\",\n  \"created_from\": [],\n  \"approver_operator\": \"\",\n  \"config_integration_target_phase\": \"S-T9|O-T9|dedicated-config-lane|unknown\",\n  \"prepared_by\": \"\",\n  \"source_contract\": [],\n  \"policy\": \"Manifest approves later resolution/planning only; it does not write config.\",\n  \"source_requests\": [],\n  \"duplicate_grouping_decisions\": [],\n  \"summary\": {\"approved\": [], \"deferred\": [], \"already_covered\": [], \"duplicates\": [], \"blocked\": [], \"rejected\": []},\n  \"items\": [],\n  \"no_implicit_writes\": true,\n  \"recommended_next_route\": \"\"\n}", color="#283593", fillcolor="#E8EAF6"];
  N19_Idempotency [label="IDEMPOTENCY CHECKS BEFORE OUTPUT\n================================\nBefore writing outputs:\n- check whether manifest already exists\n- if exists and ALLOW_OVERWRITE=no, version output or ask\n- preserve manifest decisions if source requests unchanged unless operator changed approval\n- record any changed source request or approval\n- do not duplicate item IDs\n- do not hide duplicate requests\n- do not silently upgrade deferred/blocked to approved\n- do not weaken forbidden surfaces without explicit approval.\n\nSame source requests plus same approvals should produce same manifest decisions.", color="#F9A825", fillcolor="#FFFDE7"];
  N20_SafeForbidden [label="SAFE COMMANDS / FORBIDDEN ACTIONS\n=================================\nAllowed: read provided markdown/json/spec/hook/request/evidence files; unpack source zips into sandbox; create manifest artifacts in sandbox or approved output; create missing-source report; produce CIP04 handoff.\n\nForbidden: edit config files; edit public tooling; edit DOTs; resolve live config state; mutate private evidence/companion outputs unless approved; run bootstrap/mount/pull/push; run Docker/Runpod/paid APIs/package installs/smoke/live infra; read or print credential contents; assert live config truth.", color="#BF360C", fillcolor="#FBE9E7"];
  N21_ResponseFormat [label="REQUIRED RESPONSE FORMAT\n========================\nCurrent phase: CIP03 manifest aggregation + approval\nSelected DOT:\nAddressed role:\nVariable block proposed/confirmed:\nSource contract status:\nSource requests read:\nMissing sources:\nRequest inventory summary:\nDuplicate/grouping decisions:\nManifest status counts:\nApproved items:\nDeferred items:\nBlocked/rejected items:\nAllowed/forbidden surfaces summary:\nRequired live-state checks summary:\nOutput manifest path:\nOutput JSON path if any:\nSafety status:\nDecision: PASS / STOP\nRecommended next route:", color="#37474F", fillcolor="#ECEFF1"];
  N22_PassStop [label="PASS / STOP CONDITIONS\n======================\nPASS only if variables confirmed, ANX03/hook applied or fallback documented, source requests read, inventory complete, duplicates addressed, every request has a status, approved items have bounded surfaces and required live checks, selected patch class or blocked/deferred reason exists, output contract satisfied, and no forbidden mutation occurred.\n\nSTOP if user has not confirmed, requests are missing, evidence is contradictory, approval owner/context is required but unknown, output would overwrite with ALLOW_OVERWRITE=no, or user requests live resolution, config mutation, public tooling edit, DOT edit, bootstrap, mount, pull, push, package install, smoke, or live infra.\n\nAfter PASS: do not silently run CIP04. Recommend CIP04 only for approved/partial manifests requiring live config-state resolution.", color="#B71C1C", fillcolor="#FFEBEE"];
  N23_Reentry [label="RE-ENTRY INTO CIP AND V7 PIPELINE\n=================================\nIf blocked, gather evidence/human design/operator approval.\nIf draft, revise requests or approvals.\nIf partial or approved, next route is CIP04 for approved items only.\n\nCIP03 can also feed S-T8/O-T8 integration manifest steps. It does not replace skeleton/organ implementation lanes. It is the explicit gate before config/lv/workflow planning and application.", color="#333333", fillcolor="#F5F5F5"];
  N00_Meta -> N01_BaseFormat;
  N01_BaseFormat -> N02_PhaseIdentity;
  N02_PhaseIdentity -> N03_CIPLegend;
  N03_CIPLegend -> N04_SourceContract;
  N04_SourceContract -> N05_ManifestEngine;
  N05_ManifestEngine -> N06_Variables;
  N06_Variables -> N07_ExactPrompt;
  N07_ExactPrompt -> N08_InputChecklist;
  N08_InputChecklist -> N09_RequestInventory;
  N09_RequestInventory -> N10_StatusVocabulary;
  N10_StatusVocabulary -> N11_ApprovalRubric;
  N11_ApprovalRubric -> N12_DedupeGrouping;
  N12_DedupeGrouping -> N13_ItemSchema;
  N13_ItemSchema -> N14_SurfaceGate;
  N14_SurfaceGate -> N15_LiveChecksPatchClass;
  N15_LiveChecksPatchClass -> N16_OutputContract;
  N16_OutputContract -> N17_MDTemplate;
  N17_MDTemplate -> N18_JSONTemplate;
  N18_JSONTemplate -> N19_Idempotency;
  N19_Idempotency -> N20_SafeForbidden;
  N20_SafeForbidden -> N21_ResponseFormat;
  N21_ResponseFormat -> N22_PassStop;
  N22_PassStop -> N23_Reentry;
}