digraph "CIP01_source_intake_and_suitability_determination_infractl_prompts_only_v03" {
  rankdir=TB;
  compound=true;
  splines=ortho;
  nodesep=0.55;
  ranksep=0.72;
  pad="0.25,0.25";
  fontname="Helvetica";
  fontsize=10;
  labelloc="t";
  label="CIP01 source intake + CONFIG_INFRA_SUITABILITY_DETERMINER — prompt-only DOT v03 — full base_format";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, margin="0.12,0.09"];
  edge [arrowsize=0.7, penwidth=1.25, fontname="Helvetica", fontsize=8, color="#555555"];
  N00_Meta [label="SELF-EXECUTABLE DOT \u2014 READ THIS FIRST\n=====================================\nThis is CIP01 v03. It is a full base_format prompt-only DOT, not a thin architecture sketch.\n\nIt is a standalone instruction file for a fresh ChatGPT, Codex, or WSL/operator session that has:\n- infractl.md\n- the root main v7 DOT\n- this selected CIP01 DOT\n- optional source files, evidence, notes, or private bundle material.\n\nCanonical read order:\n1. infractl.md\n2. root main v7 DOT\n3. this selected CIP01 DOT\n4. only then the source files named in the variable block.\n\nDo not mix lanes. Do not run CIP02 or later stages unless CIP01 reaches PASS and the operator explicitly starts the next phase.", color="#004D40", fillcolor="#E0F2F1"];
  N01_BaseFormat [label="base_format REQUIREMENTS APPLIED HERE\n=====================================\nThis route follows the 0A/P/G prompt-only style:\n- full cold-start narrative\n- self-executable instruction file\n- required variable block before execution\n- each variable labeled user-provided, inferred, default-safe, or unknown\n- confirmation gate before execution\n- idempotency by default\n- no overwrite unless ALLOW_OVERWRITE=yes\n- addressed-agent gate: ChatGPT / Codex / WSL operator\n- exact prompt-to-type\n- input checklist\n- explicit safe/forbidden actions\n- output contract\n- required response format\n- PASS / STOP conditions\n- re-entry guidance into the CIP and v7 pipeline.", color="#7B1FA2", fillcolor="#F3E5F5"];
  N02_PhaseIdentity [label="PHASE IDENTITY \u2014 CIP01\n======================\nMODE=config-infra\nTRACK=cip\nPHASE=CIP01\nNAME=source_intake_and_suitability_determination\n\nPurpose:\nCIP01 performs source intake and runs the CONFIG_INFRA_SUITABILITY_DETERMINER. It decides where a possible research/platform/workflow/config request belongs in the actual vmuser config/lv/workstation contract.\n\nCIP01 answers:\n- Is this still an experiment?\n- Is it project-local only?\n- Is it already covered by existing config?\n- Should it become a rich INTEGRATION_REQUEST.md?\n- Should it be a manifest candidate?\n- Is it a package-stack, env, role, mount, credential, workflow, check, or managed-step candidate?\n- Is it blocked because it is live, secret-sensitive, destructive, or under-specified?\n\nDefault mutation policy:\nREAD-ONLY / PLANNING-ONLY. No config, public tooling, DOT, private evidence, live infrastructure, bootstrap, mount, pull, push, package installation, or smoke mutation.", color="#006064", fillcolor="#E0F7FA"];
  N03_CIPLegend [label="CIP LEGEND \u2014 FULL PIPELINE CONTEXT\n==================================\nCIP = Config-Infra Pipeline.\n\nCIP01 = source intake + suitability determination.\nCIP02 = rich INTEGRATION_REQUEST generation.\nCIP03 = manifest aggregation + approval.\nCIP04 = live config-state resolution.\nCIP05 = config implementation planning.\nCIP06 = idempotent application + verification/evidence/snapshot/companion closeout.\n\nSafety invariant:\n- CIP01-CIP05 are non-mutating by default.\n- CIP06 is also mutation-default=no.\n- CIP06 may mutate only after manifest approval, implementation plan, selected CIP06 DOT, explicit confirmation, and all safety gates pass.\n\nTruth split:\n- CIP01 produces batch-time suitability truth.\n- CIP04 is the first phase that resolves integration-time live config truth.", color="#263238", fillcolor="#ECEFF1"];
  N04_SourceContract [label="REQUIRED SOURCE CONTRACT \u2014 ANX01 + ANX06 + SUITABILITY HOOK\n===========================================================\nCIP01 must explicitly implement these accepted source materials when they are available in the bundle or source pack:\n\nRequired conceptual sources:\n- SPEC_config_infra_integration_pipeline.md\n- SPEC_config_infra_integration_pipeline-ANX01_config_infra_suitability_determiner.md\n- SPEC_config_infra_integration_pipeline-ANX06_config_patch_classes.md\n- HOOK_config_infra_suitability_assessment.md\n\nANX01 provides:\n- evidence strength axes\n- recurrence axes\n- role fit axes\n- environment fit axes\n- config impact axes\n- risk axes\n- fate categories\n- fate decision rules\n- decision output schema.\n\nANX06 provides:\n- allowed patch classes\n- patch-class vocabulary\n- allowed/forbidden implementation shapes\n- future implementation boundaries.\n\nThe suitability hook provides:\n- when to apply the determiner\n- required classification axes\n- the rule that CIP01 produces batch-time suitability truth, not approval.\n\nIf any required source document is missing, CIP01 may still proceed only if the selected DOT itself contains the necessary fallback rules. It must record missing sources in the output decision.", color="#1A237E", fillcolor="#E8EAF6"];
  N05_Determiner [label="CONFIG_INFRA_SUITABILITY_DETERMINER \u2014 REQUIRED DECISION ENGINE\n==============================================================\nThe determiner is the core of CIP01. It is not optional and must not be replaced by a narrative summary.\n\nRequired determiner axes:\n1. Evidence strength\n2. Recurrence / maturity\n3. Role fit\n4. Target identity fit\n5. Workspace/artifact fit\n6. Python/lv fit\n7. Package-stack fit\n8. Bootstrap-step fit\n9. Mount / SMB / credential fit\n10. Workflow / alias / launcher fit\n11. Health / smoke / check fit\n12. Risk boundary\n13. Primary fate\n14. Secondary fate notes\n15. Manifest eligibility\n16. Recommended next route\n17. Resolution required at integration time: yes/no\n\nCIP01 must say whether the request is:\n- not config\n- experiment-local only\n- project-local only\n- already covered\n- a request-only handoff\n- a manifest candidate\n- an existing-step enablement\n- a package/env/role/mount/workflow/check candidate\n- blocked for design, live, secret, destructive, or missing-evidence reasons.\n\nCIP01 must not state that config changes are approved or valid in the current live environment.", color="#BF360C", fillcolor="#FBE9E7"];
  N06_Variables [label="REQUIRED VARIABLE BLOCK \u2014 PROPOSE BEFORE EXECUTION\n==================================================\nThe assistant must propose this variable block and stop for confirmation.\n\nMODE=config-infra\nTRACK=cip\nPHASE=CIP01\nPIPELINE_NAME=Config-Infra Pipeline\nREQUEST_ID=<short stable slug>\nREQUEST_TOPIC=<short human label>\nSOURCE_PATHS=<uploaded/source/evidence files>\nREQUEST_SOURCE_TYPE=operator-note | batch-evidence | postcheck-smoke | codebase-report | integration-request | companion | spec | mixed\nTARGET_ROLE_HINT=researchscientist | aiengineer | publisher | vmuser/operator | mixed | unknown | not-role-specific\nTARGET_IDENTITY_HINT=<target user if known>\nOUTPUT_ROOT=<sandbox output or approved report directory>\nOUTPUT_DECISION_MD=CONFIG_INFRA_SUITABILITY_DECISION.md\nOUTPUT_DECISION_JSON=CONFIG_INFRA_SUITABILITY_DECISION.json\nALLOW_CONFIG_MUTATION=no\nALLOW_PUBLIC_TOOL_EDIT=no\nALLOW_DOT_MUTATION=no\nALLOW_EVIDENCE_MUTATION=no\nALLOW_BOOTSTRAP=no\nALLOW_MOUNT_PULL_PUSH=no\nALLOW_LIVE_INFRA=no\nALLOW_OVERWRITE=no\n\nEach variable must be labeled:\nuser-provided | inferred | default-safe | unknown.", color="#F57F17", fillcolor="#FFF8E1"];
  N07_ExactPrompt [label="EXACT PROMPT TO TYPE\n====================\nUse infractl.md and infractl.zip.\nRun CIP01 Config-Infra Pipeline for the uploaded source files.\n\nTask:\nPerform source intake and config-infra suitability determination. Apply the CONFIG_INFRA_SUITABILITY_DETERMINER. Produce CONFIG_INFRA_SUITABILITY_DECISION.md and, when possible, CONFIG_INFRA_SUITABILITY_DECISION.json.\n\nDo not generate INTEGRATION_REQUEST.md yet unless CIP01 reaches PASS and I explicitly start CIP02.\n\nRead infractl.md first.\nRead the root main v7 DOT next.\nThen read exactly this CIP01 DOT.\nSuggest the routing and variable block first.\nAsk me to confirm or correct it.\nDo not execute until I confirm.\n\nDo not mutate config files, public tooling, DOT files, private evidence, or live infrastructure. Do not run bootstrap, mount, pull, push, Docker, Runpod, paid APIs, package installation, broad smoke, or credential reads.", color="#2E7D32", fillcolor="#E8F5E9"];
  N08_InputChecklist [label="INPUT CHECKLIST \u2014 WHAT CIP01 MAY CONSUME\n========================================\nCIP01 may consume:\n- operator notes or experiment request\n- SPEC.md / RUN_INSTRUCTIONS.md / CODEX_PROMPT.txt / PROJECT_CACHE.md\n- POSTCHECK.md / SMOKE_REPORT.md / INTEGRATION_REQUEST.md\n- codebase analysis reports\n- COMPANION.md\n- changed-file lists\n- package/import evidence\n- private workflow/spec/hook material\n- CONFIG_TOOL.md and current config workflow/developer guides\n- accepted 0B SPEC/ANX/hook material\n- optional CIP04 CONFIG_STATE_SNAPSHOT from a previous run, if available.\n\nCIP01 must record which inputs were present, missing, stale, or insufficient.\n\nIf live config state is not provided, mark:\nresolution_required_at_integration_time=yes.", color="#1565C0", fillcolor="#E3F2FD"];
  N09_QualityRubric [label="SOURCE QUALITY AND MATURITY RUBRIC\n==================================\nEvidence strength values:\n- idea-only\n- operator-request-only\n- spec-only\n- code-intent-only\n- implemented-code\n- implemented-code-plus-postcheck\n- implemented-code-plus-smoke\n- implemented-code-plus-smoke-and-companion\n- repeated-across-batches\n- core-platform-contract\n\nRecurrence values:\n- one-off\n- prototype\n- manual-repeated-once\n- manual-repeated-multiple-times\n- required-by-one-batch\n- required-by-multiple-batches\n- required-by-role\n- required-by-platform\n\nGuidance:\n- Weak evidence should not become config mutation.\n- Prototype/one-off needs usually remain experiment_local_only.\n- Repeated role/platform needs may become manifest candidates.\n- Core platform contracts may justify early manifest consideration, but still need live-state resolution later.", color="#0277BD", fillcolor="#E1F5FE"];
  N10_FitMatrix [label="CONFIG CONTRACT FIT MATRIX\n==========================\nCIP01 must fill this matrix. It may name likely later surfaces but must not instruct edits.\n\nAccount/profile fit:\nclassification = none | existing account profile | new account profile | unknown\nlikely surfaces = accounts/profiles.tsv\nevidence = <why>\nresolution needed in CIP04 = yes/no\n\nTarget identity fit:\nclassification = none | existing target user | new target user | mixed | unknown\nlikely surfaces = targets/<user>.env; /home/<target>/.local/state/config-sh/\nevidence = <why>\nresolution needed in CIP04 = yes/no\n\nSMB/mount fit:\nclassification = none | existing SMB/mount profile | new mount/share policy | credential-sensitive | unknown\nlikely surfaces = accounts/smb-profiles.tsv; accounts/mount-profiles.tsv; mounts/mounts.env\nevidence = <why>\nresolution needed in CIP04 = yes/no\n\nPython/lv fit:\nclassification = none | prototype env | existing role env | new env profile | system python forbidden | unknown\nlikely surfaces = install/python-env-profiles.tsv; targets/<user>.env; lv/conda/venv state\nevidence = <why>\nresolution needed in CIP04 = yes/no\n\nPackage-stack fit:\nclassification = none | one-off prototype package | existing package variable | package-stack extension | unknown\nlikely surfaces = install/packages.env\nevidence = <package names, import names, smoke/test evidence>\nresolution needed in CIP04 = yes/no\n\nBootstrap-step fit:\nclassification = none | existing managed step | role-plan update | new check step | new install step | unknown\nlikely surfaces = bootstrap/steps.tsv; bootstrap/profiles/*.plan; config.sh allowlist; installers.sh\nevidence = <why>\nresolution needed in CIP04 = yes/no\n\nWorkflow exposure fit:\nclassification = none | project-local command | target-role command | alias/launcher candidate | health/smoke hook | unknown\nlikely surfaces = role workflow docs; aliases/launchers; smoke/check hooks\nevidence = <why>\nresolution needed in CIP04 = yes/no\n\nRisk boundary:\nclassification = safe-read-only | target-owned write | operator-policy write | trusted-function write | credential-sensitive | live-infra-sensitive | destructive\nstop rule = <if risk is high, what must stop or defer>", color="#455A64", fillcolor="#ECEFF1"];
  N11_FateRubric [label="FATE DECISION RUBRIC\n====================\nAssign exactly one primary fate and optional secondary fates.\n\nAllowed primary fate vocabulary:\n- ignore_not_config\n- experiment_local_only\n- record_integration_request_only\n- manifest_candidate\n- already_covered_by_existing_config\n- enable_existing_step\n- package_stack_extension\n- target_env_policy_update\n- python_env_profile_update\n- role_bootstrap_plan_update\n- new_managed_check_step\n- new_managed_install_step\n- new_role_or_account_profile\n- mount_share_policy_update\n- credential_workflow_update\n- workflow_alias_launcher_update\n- smoke_or_health_check_update\n- blocked_needs_human_design\n- blocked_live_or_secret_sensitive\n\nDecision hints:\n- experiment_local_only: one-off/prototype package/env/code, no repeated evidence.\n- package_stack_extension: repeated role-level package need with strong package/import evidence.\n- enable_existing_step: step/function/allowlist likely exists; missing piece may be plan/marker placement, but live proof waits for CIP04.\n- new_managed_check_step: read-only readiness/status/smoke check candidate.\n- new_managed_install_step: stable repeated install behavior with clear role/env validation.\n- new_role_or_account_profile: new identity/mount/env/profile need, operator design required.\n- blocked_live_or_secret_sensitive: live provider/Runpod submit/credential/destructive/mount-sensitive request without guardrails.", color="#33691E", fillcolor="#F1F8E9"];
  N12_RiskRubric [label="RISK BOUNDARY RUBRIC\n====================\nRisk values:\n- safe-read-only\n- project-local-write\n- target-owned-write\n- operator-policy-write\n- trusted-function-write\n- account-lifecycle-sensitive\n- mount-share-sensitive\n- credential-sensitive\n- live-infra-sensitive\n- destructive-or-hard-to-rollback\n\nRules:\n- safe-read-only can proceed in CIP01 as decision generation.\n- project-local or target-owned write can be recorded but not performed in CIP01.\n- operator-policy write, trusted-function write, account lifecycle, mount/share, credential, live infra, or destructive classes require later manifest approval and never happen in CIP01.\n- If secrets, credentials, live providers, or destructive account actions are requested, stop or classify as blocked_live_or_secret_sensitive unless explicit guarded design exists.", color="#B71C1C", fillcolor="#FFEBEE"];
  N13_ManifestEligibility [label="MANIFEST ELIGIBILITY DECISION\n=============================\nCIP01 must decide whether the request can proceed toward CIP02/CIP03.\n\nAllowed manifest eligibility values:\n- not_eligible_not_config\n- not_eligible_experiment_only\n- eligible_request_only\n- eligible_manifest_candidate\n- eligible_already_covered_check\n- eligible_existing_step_resolution\n- eligible_package_stack_review\n- eligible_new_check_step_review\n- eligible_new_install_step_review\n- eligible_role_profile_design_review\n- blocked_missing_evidence\n- blocked_human_design_required\n- blocked_live_secret_destructive\n\nCIP01 does not approve implementation. It only says whether a rich INTEGRATION_REQUEST should be generated next and which manifest gate should later review it.", color="#6A1B9A", fillcolor="#F3E5F5"];
  N14_OutputContract [label="OUTPUT ARTIFACT CONTRACT\n========================\nPrimary output artifacts:\n- CONFIG_INFRA_SUITABILITY_DECISION.md\n- CONFIG_INFRA_SUITABILITY_DECISION.json when machine output is useful or requested\n\nRequired minimum fields:\nrequest_id\nsource_files\nsource_summary\nsource_quality\nevidence_strength\nrecurrence\nrole_owner\ntarget_identity\ntarget_work_identity\nconfig_side_operator_identity\nworkspace_roots\ncommands_or_entrypoints\nartifacts_or_outputs\nobserved_packages_or_imports\nsmoke_or_health_evidence\nconfig_contract_fit_matrix\nrisk_boundary\nprimary_fate\nsecondary_fates\nmanifest_eligibility\nrecommended_next_route\nresolution_required_at_integration_time\nconfig_surfaces_likely_involved\nconfig_surfaces_forbidden\nrequired_live_state_checks\nrequired_evidence_before_promotion\nstop_conditions\nsafety_statement\n\nThe output must explicitly state:\nCIP01 must not resolve live current config state.\nCIP01 may identify likely config surfaces.\nCIP04 is the first phase that resolves live config truth.", color="#2E7D32", fillcolor="#E8F5E9"];
  N15_MDTemplate [label="CONFIG_INFRA_SUITABILITY_DECISION.md TEMPLATE\n=============================================\n# CONFIG_INFRA_SUITABILITY_DECISION \u2014 <request_id>\n\n## Request identity\nRequest ID:\nTopic:\nSource type:\nDate/context:\n\n## Source intake\nSource files read:\nMissing sources:\nSource summary:\n\n## Source quality and maturity\nEvidence strength:\nRecurrence:\nReason:\n\n## Role and identity fit\nRole owner:\nTarget identity:\nTarget work identity:\nConfig-side operator identity:\n\n## Work products observed\nWorkspace roots:\nCommands or entrypoints:\nArtifacts or outputs:\nObserved packages/imports:\nSmoke or health evidence:\n\n## Config contract fit matrix\n<fill account/profile, target identity, SMB/mount, Python/lv, package-stack, bootstrap-step, workflow exposure, risk boundary rows>\n\n## Fate decision\nPrimary fate:\nSecondary fates:\nManifest eligibility:\nReason:\n\n## Later config surfaces\nLikely involved later:\nForbidden surfaces:\nResolution required at integration time: yes/no\nRequired live-state checks:\nRequired evidence before promotion:\n\n## Recommended next route\nRecommended next route:\nStop conditions:\n\n## Safety statement\nNo live config state was resolved in CIP01. No config/public/DOT/evidence/live mutation was performed.", color="#00695C", fillcolor="#E0F2F1"];
  N16_JSONTemplate [label="CONFIG_INFRA_SUITABILITY_DECISION.json TEMPLATE\n===============================================\n{\n  \"request_id\": \"\",\n  \"source_files\": [],\n  \"source_summary\": \"\",\n  \"source_quality\": \"\",\n  \"evidence_strength\": \"\",\n  \"recurrence\": \"\",\n  \"role_owner\": \"\",\n  \"target_identity\": \"\",\n  \"target_work_identity\": \"\",\n  \"config_side_operator_identity\": \"vmuser/operator\",\n  \"workspace_roots\": [],\n  \"commands_or_entrypoints\": [],\n  \"artifacts_or_outputs\": [],\n  \"observed_packages_or_imports\": [],\n  \"smoke_or_health_evidence\": [],\n  \"config_contract_fit_matrix\": {\n    \"account_profile_fit\": {},\n    \"target_identity_fit\": {},\n    \"smb_mount_fit\": {},\n    \"python_lv_fit\": {},\n    \"package_stack_fit\": {},\n    \"bootstrap_step_fit\": {},\n    \"workflow_exposure_fit\": {},\n    \"risk_boundary\": {}\n  },\n  \"risk_boundary\": \"\",\n  \"primary_fate\": \"\",\n  \"secondary_fates\": [],\n  \"manifest_eligibility\": \"\",\n  \"recommended_next_route\": \"\",\n  \"resolution_required_at_integration_time\": true,\n  \"config_surfaces_likely_involved\": [],\n  \"config_surfaces_forbidden\": [],\n  \"required_live_state_checks\": [],\n  \"required_evidence_before_promotion\": [],\n  \"stop_conditions\": [],\n  \"safety_statement\": \"CIP01 did not resolve live config state and performed no config/public/DOT/evidence/live mutation.\"\n}", color="#283593", fillcolor="#E8EAF6"];
  N17_Idempotency [label="IDEMPOTENCY CHECKS BEFORE OUTPUT\n================================\nBefore writing outputs:\n- check whether an equivalent decision already exists under OUTPUT_ROOT or in the source pack\n- if it exists and ALLOW_OVERWRITE=no, create a versioned output or ask for confirmation\n- same input plus same evidence should produce same fate\n- if fate changes, record exactly what new evidence changed the decision\n- do not duplicate decisions silently\n- do not overwrite prior decision artifacts.", color="#F9A825", fillcolor="#FFFDE7"];
  N18_Safety [label="SAFE COMMANDS / FORBIDDEN ACTIONS\n=================================\nAllowed in CIP01:\n- list uploaded/sandbox files\n- read provided markdown/spec/evidence/codebase reports\n- unpack source zips into sandbox\n- produce sandbox decision artifacts\n- produce operator handoff text for later phases\n\nForbidden in CIP01:\n- edit config files\n- edit public tooling\n- edit main DOT or CIP DOT files\n- mutate private evidence or companion outputs\n- run bootstrap, mount, pull, push\n- run Docker, Runpod, paid APIs, package installs, broad smoke, or live infra\n- read or print credential contents\n- assert current live config state unless provided by an explicit prior CIP04 snapshot.", color="#BF360C", fillcolor="#FBE9E7"];
  N19_ResponseFormat [label="REQUIRED RESPONSE FORMAT\n========================\nCurrent phase: CIP01 source intake + suitability determination\nSelected DOT:\nAddressed role:\nVariable block proposed/confirmed:\nSource files read:\nMissing sources:\nRequired source contract status:\nSource quality:\nRole / target identity hints:\nConfig contract fit matrix summary:\nRisk boundary:\nPrimary fate:\nManifest eligibility:\nResolution required at integration time:\nOutputs created/proposed:\nSafety status:\nDecision: PASS / STOP\nRecommended next route:", color="#37474F", fillcolor="#ECEFF1"];
  N20_PassStop [label="PASS / STOP CONDITIONS\n======================\nPASS only if:\n- variables confirmed\n- source files read or missing sources listed\n- ANX01/ANX06/hook source contract applied or fallback noted\n- source quality classified\n- full config contract fit matrix completed\n- risk boundary classified\n- primary fate assigned\n- manifest eligibility assigned\n- output artifact contract satisfied or proposed\n- no forbidden mutation occurred.\n\nSTOP if:\n- user has not confirmed\n- required sources are unavailable and no fallback is sufficient\n- source evidence is contradictory and needs operator input\n- requested action is config mutation, live infra, credentials, destructive, bootstrap, mount, pull, push, public tooling edit, DOT edit, or evidence mutation\n- role/target/context cannot be represented even as unknown\n- output would overwrite existing artifact with ALLOW_OVERWRITE=no.\n\nAfter PASS:\nDo not silently run CIP02. Recommend CIP02 only if a rich INTEGRATION_REQUEST should be generated.", color="#B71C1C", fillcolor="#FFEBEE"];
  N21_Reentry [label="RE-ENTRY INTO CIP AND V7 PIPELINE\n=================================\nIf primary fate is ignore_not_config or experiment_local_only, operator may stop or keep decision as a note.\n\nIf fate is record_integration_request_only, manifest_candidate, already_covered_by_existing_config, enable_existing_step, package_stack_extension, env/profile/workflow/managed-step candidate, or blocked_needs_human_design, the normal next route is CIP02 to generate a rich INTEGRATION_REQUEST.md.\n\nIf the user asks for live config-state truth, route to CIP04 only after CIP03 manifest context exists or after explicit operator request for read-only live inventory.\n\nCIP01 can feed normal request-create/request-update lanes. It does not replace skeleton/organ P lanes; it supplies the config-infra suitability layer those lanes should carry forward.", color="#333333", fillcolor="#F5F5F5"];
  N00_Meta -> N01_BaseFormat;
  N01_BaseFormat -> N02_PhaseIdentity;
  N02_PhaseIdentity -> N03_CIPLegend;
  N03_CIPLegend -> N04_SourceContract;
  N04_SourceContract -> N05_Determiner;
  N05_Determiner -> N06_Variables;
  N06_Variables -> N07_ExactPrompt;
  N07_ExactPrompt -> N08_InputChecklist;
  N08_InputChecklist -> N09_QualityRubric;
  N09_QualityRubric -> N10_FitMatrix;
  N10_FitMatrix -> N11_FateRubric;
  N11_FateRubric -> N12_RiskRubric;
  N12_RiskRubric -> N13_ManifestEligibility;
  N13_ManifestEligibility -> N14_OutputContract;
  N14_OutputContract -> N15_MDTemplate;
  N15_MDTemplate -> N16_JSONTemplate;
  N16_JSONTemplate -> N17_Idempotency;
  N17_Idempotency -> N18_Safety;
  N18_Safety -> N19_ResponseFormat;
  N19_ResponseFormat -> N20_PassStop;
  N20_PassStop -> N21_Reentry;
}